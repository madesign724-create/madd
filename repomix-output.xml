  "id" integer PRIMARY KEY, "legalName" varchar(180) NOT NULL, "arabicName" varchar(180) NOT NULL,
  "supportEmail" varchar(320) NOT NULL, "supportPhone" varchar(32), "address" text, "website" varchar(300), "logoUrl" text,
  "publicTagline" varchar(300) NOT NULL, "publicHeroTitle" varchar(300) NOT NULL, "publicHeroBody" text, "reportFooter" varchar(500) NOT NULL,
  "ownerUserId" integer, "backupOwnerUserId" integer, "createdAt" timestamptz NOT NULL DEFAULT now(), "updatedAt" timestamptz NOT NULL DEFAULT now()
);
CREATE TABLE IF NOT EXISTS "admin_activity_logs" (
  "id" integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, "actorUserId" integer NOT NULL, "action" varchar(100) NOT NULL,
